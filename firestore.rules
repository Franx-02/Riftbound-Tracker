rules_version = '2';

// Modelo de acceso: registro abierto.
// - Entra cualquier cuenta de Google (email verificado, que en Google siempre lo está).
// - Cualquier usuario puede LEER la colección y el nombre de los demás (en solo lectura).
// - Cada usuario solo puede ESCRIBIR bajo su propio uid.
// - Como escribe cualquiera, se valida la forma de cada documento: así nadie guarda basura
//   ni documentos enormes que gasten la cuota gratuita.
// Todo dato nuevo necesita su regla aquí: lo que no aparece, se deniega.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function copies(v) {
      return v is int && v >= 0 && v <= 9999;
    }

    // Perfil público: solo el nombre para mostrar. El email NO se guarda aquí, porque con
    // registro abierto lo leería cualquier desconocido.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName'])
        && shortString(request.resource.data.displayName, 80);
    }

    // Colección: users/{uid}/collection/{cardId} = { normal, foil, alias? }.
    // `alias` es el id original de DotGG de una carta enlazada al importar (OGS-004-P → OPP-004).
    match /users/{uid}/collection/{cardId} {
      allow read: if signedIn();
      allow delete: if owner(uid);
      allow create, update: if owner(uid)
        && cardId.size() <= 20
        && request.resource.data.keys().hasOnly(['normal', 'foil', 'alias'])
        && copies(request.resource.data.normal)
        && copies(request.resource.data.foil)
        && (!('alias' in request.resource.data) || shortString(request.resource.data.alias, 20));
    }

    // Correcciones de mapeo compartidas: cualquiera lee y corrige, y vale para todos.
    // Las reglas no pueden comprobar que `by` sea de verdad el nombre de quien escribe,
    // pero sí que el documento tenga solo estos campos y con tamaños razonables.
    match /mappingOverrides/{cardId} {
      allow read: if signedIn();
      allow delete: if signedIn();
      allow create, update: if signedIn()
        && cardId.size() <= 20
        && request.resource.data.keys().hasOnly(['idProduct', 'by', 'at'])
        && request.resource.data.idProduct is int
        && shortString(request.resource.data.by, 80)
        && shortString(request.resource.data.at, 40);
    }
  }
}
